# Somente desenvolvimento local; nunca copie este override para produção.
FLEET_OWNER_ID=local_seedy

# WhatsApp Business Cloud API: credencial apenas no servidor.
# Cadastre os valores reais como segredos/configurações do Worker em produção.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Template utilitário aprovado: código, título/parte, texto do resumo.
# WHATSAPP_TEMPLATE_RENTAL=

# URL HTTPS real, opcional para incluir o guia de cuidados nos avisos.
# APP_PUBLIC_URL=https://seu-dominio.example
# WHATSAPP_SITE_URL=https://seu-dominio.example

# Só para invocar POST /api/notifications por agendador HTTP externo.
# O agendamento nativo do Worker funciona sem este segredo.
# NOTIFY_CRON_SECRET=

# PRODUÇÃO: segredo provisório de >=32 caracteres para criar/recuperar admin.
# ADMIN_SETUP_KEY=
# Remova após configurar a senha. Não colocar valores reais neste arquivo.

# Somente histórico: preserve a chave ORIGINAL se já existem cadastros cifrados.
# Não é necessária para novos contatos mínimos; não gere chave substituta.
# CUSTOMER_DATA_KEY=

# Arquivo de vistoria via WhatsApp da empresa, opcional.
# WHATSAPP_TEMPLATE_INSPECTION=
# INSPECTION_ARCHIVE_PHONE=
